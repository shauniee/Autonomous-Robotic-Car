@@ -14,6 +14,7 @@
 #include <stdint.h>
 #include "../app.h"
 #include "robot_time_math.h"
+#include "robot_config.h"
 
 /* Kernel milliseconds since boot. tk_get_otm() always returns E_OK
    (kernel/tkernel/time_calls.c), so no error path is reported here. */
@@ -30,4 +31,19 @@ static inline uint32_t robot_time_us(void)
     return in_w(TIMER_TIMERAWL);
 }
 
+/* Every LOOP_TIMING_REPORT_MS print one console line for S3-M02, then start
+   a new window. Cheap enough for every build; silent without a console. */
+static inline void loop_timing_report(LoopTiming *t, const char *name, uint32_t period_us,
+    uint32_t *report_due, uint32_t now_ms)
+{
+    if (!robot_time_reached(now_ms, *report_due))
+    {
+        return;
+    }
+    tm_printf((UB *)"[TIMING] task=%s max_us=%u period_us=%u overruns=%u loops=%u\n",
+        name, (unsigned)t->max_us, (unsigned)period_us, (unsigned)t->overruns, (unsigned)t->count);
+    *t = (LoopTiming){0};
+    *report_due = now_ms + LOOP_TIMING_REPORT_MS;
+}
+
 #endif /* ROBOT_TIME_H */
diff --git a/app_program/common/robot_time_math.h b/app_program/common/robot_time_math.h
index f167022..fe91c37 100644
--- a/app_program/common/robot_time_math.h
+++ b/app_program/common/robot_time_math.h
@@ -38,4 +38,32 @@ static inline uint32_t robot_time_next_delay(uint32_t *release, uint32_t period,
     return *release - now;
 }
 
+/* Worst-case execution time of a periodic loop body (S3-M02), in TIMER
+   microseconds: begin at the release, end just before the delay. A body
+   that uses the whole period or more counts as an overrun. */
+typedef struct
+{
+    uint32_t start_us;
+    uint32_t max_us;
+    uint32_t count;
+    uint32_t overruns;
+} LoopTiming;
+
+static inline void loop_timing_begin(LoopTiming *t, uint32_t now_us)
+{
+    t->start_us = now_us;
+}
+
+static inline void loop_timing_end(LoopTiming *t, uint32_t now_us, uint32_t period_us)
+{
+    uint32_t used = robot_time_elapsed(now_us, t->start_us);
+    if (used > t->max_us) {
+        t->max_us = used;
+    }
+    if (used >= period_us) {
+        ++t->overruns;
+    }
+    ++t->count;
+}
+
 #endif /* ROBOT_TIME_MATH_H */
